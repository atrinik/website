---
import site from "../data/site.json";
import media from "../data/media.json";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  preloadImage?: string;
  noindex?: boolean;
}

const title = Astro.props.title
  ? `${Astro.props.title} · ${site.title}`
  : site.title;
const description = Astro.props.description ?? site.description;
const canonical = new URL(
  Astro.props.canonicalPath ?? Astro.url.pathname,
  site.canonicalOrigin,
);
const currentPath = Astro.url.pathname;
const socialImage = media.entries.find((entry) => entry.id === "atrinik-now");
if (!socialImage) throw new Error("missing social media record: atrinik-now");
const socialImageUrl = new URL(socialImage.publicPath, site.canonicalOrigin);
const navigation = [
  { label: "Home", href: "/" },
  { label: "About", href: "/about/" },
  { label: "Downloads", href: "/downloads/" },
  { label: "Licenses", href: "/licenses/" },
];
const isCurrent = (href: string) =>
  href === "/" ? currentPath === href : currentPath.startsWith(href);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    {
      Astro.props.noindex ? (
        <meta name="robots" content="noindex, nofollow" />
      ) : null
    }
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#07111d" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.title} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:alt" content={socialImage.alt} />
    <meta property="og:image:width" content={String(socialImage.width)} />
    <meta property="og:image:height" content={String(socialImage.height)} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <meta name="twitter:image:alt" content={socialImage.alt} />
    {
      Astro.props.preloadImage ? (
        <link
          rel="preload"
          as="image"
          href={Astro.props.preloadImage}
          type="image/webp"
        />
      ) : null
    }
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#content">Skip to content</a>
    <header class="site-header">
      <div class="header-inner">
        <a class="brand" href="/" aria-label="Atrinik home">
          <span class="brand-mark" aria-hidden="true"><i></i></span>
          <span class="brand-name">Atrinik</span>
        </a>
        <nav aria-label="Primary navigation">
          {
            navigation.map(({ label, href }) => (
              <a
                href={href}
                aria-current={isCurrent(href) ? "page" : undefined}
              >
                {label}
              </a>
            ))
          }
        </nav>
        <a
          class="header-link"
          href="https://github.com/atrinik/atrinik"
          aria-label="View the Atrinik project workspace on GitHub"
        >
          <span>GitHub</span><span aria-hidden="true">↗</span>
        </a>
      </div>
    </header>
    <main id="content"><slot /></main>
    <footer class="site-footer">
      <div class="footer-inner">
        <div class="footer-intro">
          <a class="brand brand--footer" href="/" aria-label="Atrinik home">
            <span class="brand-mark" aria-hidden="true"><i></i></span>
            <span class="brand-name">Atrinik</span>
          </a>
          <p>
            {site.identity.heading} Human code contributions are welcome.
          </p>
        </div>
        <div class="footer-links">
          <div>
            <h2>Explore</h2>
            <a href="/about/">About Atrinik</a>
            <a href="/downloads/">Downloads</a>
            <a href="/licenses/">Licenses</a>
          </div>
          <div>
            <h2>Project</h2>
            {
              site.externalLinks.map(({ label, url }) => (
                <a href={url}>{label}</a>
              ))
            }
          </div>
        </div>
      </div>
      <div class="footer-bottom">
        <p>
          Human-made does not mean solely Atrinik-original: creators, upstream
          projects, and exact licenses retain their credit.
        </p>
        <p>
          <a href="/licenses/">Authorship, provenance, and licenses</a> · No cookies
          or tracking.
        </p>
      </div>
    </footer>
  </body>
</html>
