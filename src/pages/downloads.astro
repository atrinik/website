---
import Base from "../layouts/Base.astro";
import downloads from "../data/downloads.json";

const download = downloads.entries.find((entry) => entry.primary);
const platformNames: Record<string, string> = {
  linux: "Linux",
  macos: "macOS",
  windows: "Windows",
};
const formatBytes = (bytes: number) =>
  `${(bytes / 1024 ** 2).toFixed(2)} MiB (${bytes.toLocaleString("en-US")} bytes)`;
---

<Base
  title="Downloads"
  description="Find the unified, maintained Atrinik Classic releases and learn the status of the independently released replacement foundations."
>
  <header class="page-hero">
    <p class="eyebrow">Choose your path</p>
    <h1 class="page-title">Play the classic. Follow what comes next.</h1>
    <p class="page-lede">
      Atrinik Classic is the current playable, actively maintained game. Its
      software follows one coordinated 5.x release line; the next-generation
      foundations do not yet form a complete public download.
    </p>
  </header>

  <section class="section" aria-labelledby="download-paths-heading">
    <div class="section-heading">
      <p class="eyebrow">Release status</p>
      <h2 id="download-paths-heading">Two lines, clearly labeled</h2>
      <p>
        Classic and next-generation software have different licenses and
        different levels of readiness.
      </p>
    </div>

    <div class="split-grid">
      <article class="path-card path-card--classic">
        <div class="path-card-topline">
          <span class="path-number">Path I</span>
          <span class="status-tag status-tag--live">Playable now</span>
        </div>
        <h3>Atrinik Classic</h3>
        <p>
          The unified{" "}<code>atrinik/classic</code> repository is the supported
          GPL-2.0-or-later software line. Use its release notes to confirm which published
          fixes, packages, platforms, and compatibility details apply before choosing
          an artifact.
        </p>
        <ul class="path-details">
          <li>Current playable implementation</li>
          <li>One repository, version, and release notes stream</li>
          <li>GPL-2.0-or-later software</li>
        </ul>
        <div class="card-actions">
          {
            download ? (
              <a class="button button--primary" href={download.url}>
                Download Classic {download.version}
              </a>
            ) : (
              <a
                class="button button--primary"
                href="https://github.com/atrinik/classic/releases"
              >
                View all Classic releases
              </a>
            )
          }
        </div>
      </article>

      <article class="path-card path-card--future">
        <div class="path-card-topline">
          <span class="path-number">Path II</span>
          <span class="status-tag">Not yet downloadable</span>
        </div>
        <h3>Next generation</h3>
        <p>
          The independently released, clean-room MIT Go and Rust repositories
          provide foundations in development. They do not yet make up a complete
          game, so no next-generation download is offered here.
        </p>
        <ul class="path-details">
          <li>Clean-room foundation repositories</li>
          <li>MIT-licensed software</li>
          <li>No public download</li>
        </ul>
        <div class="card-actions">
          <a
            class="link-arrow"
            href="https://github.com/atrinik/atrinik/issues/168"
          >
            Follow the replacement roadmap <span aria-hidden="true">→</span>
          </a>
        </div>
      </article>
    </div>
  </section>

  <section class="section" aria-labelledby="catalog-heading">
    {
      download ? (
        <article class="download-card" id="classic-client-download">
          <div class="download-card__intro">
            <div>
              <p class="eyebrow">Site-verified immutable release</p>
              <h2 id="catalog-heading">Atrinik Classic {download.version}</h2>
              <p class="download-lede">
                The supported portable client for Windows x86_64. This exact
                artifact was deliberately selected from a complete, published,
                non-prerelease release in its owning repository.
              </p>
            </div>
            <div class="card-actions">
              <a class="button button--primary" href={download.url}>
                Download the client ZIP
              </a>
              <a
                class="button button--ghost"
                href="https://github.com/atrinik/classic/releases"
              >
                View all Classic releases
              </a>
            </div>
          </div>

          <dl class="download-facts">
            <div>
              <dt>Version</dt>
              <dd>{download.version}</dd>
            </div>
            <div>
              <dt>Platform</dt>
              <dd>
                {platformNames[download.platform]} {download.architecture}
              </dd>
            </div>
            <div>
              <dt>Archive</dt>
              <dd>{download.archiveFormat.toUpperCase()}</dd>
            </div>
            <div>
              <dt>Size</dt>
              <dd>{formatBytes(download.bytes)}</dd>
            </div>
            <div class="download-facts__wide">
              <dt>Source revision</dt>
              <dd>
                <code>{download.revision}</code>
              </dd>
            </div>
            <div class="download-facts__wide">
              <dt>SHA-256</dt>
              <dd>
                <code>{download.sha256}</code>
              </dd>
            </div>
          </dl>

          <div class="download-guidance">
            <section aria-labelledby="install-heading">
              <h3 id="install-heading">Install and compatibility</h3>
              <p>{download.installation}</p>
              <p>{download.compatibility}</p>
              <p>
                No supported native Linux or macOS Classic client or editor
                binary is currently published.
              </p>
            </section>
            <section aria-labelledby="license-heading">
              <h3 id="license-heading">License boundary</h3>
              <p>
                Classic software is licensed under{" "}
                <strong>{download.softwareLicense}</strong>.{" "}
                {download.bundledAssetsLicense}
              </p>
              <p>
                The website’s MIT license does not replace the terms carried by
                files inside this ZIP.
              </p>
            </section>
          </div>

          <section class="verification" aria-labelledby="verification-heading">
            <h3 id="verification-heading">Verify before running</h3>
            <ol>
              <li>
                In PowerShell, run{" "}
                <code>
                  Get-FileHash .\{download.artifact} -Algorithm SHA256
                </code>{" "}
                and compare its result with the full digest above.
              </li>
              <li>
                Inspect the <a href={download.manifestUrl}>release manifest</a>{" "}
                and <a href={download.checksumsUrl}>checksum list</a> for the
                exact filename, size, revision, and digest.
              </li>
              <li>
                Review the <a href={download.sbomUrl}>SPDX SBOM</a> and{" "}
                <a href={download.releaseNotesUrl}>release notes</a>. GitHub has
                a provenance attestation for this artifact; after installing the
                GitHub CLI, verify the downloaded file with{" "}
                <code>
                  gh attestation verify {download.artifact} --repo{" "}
                  {download.releaseRepository}
                </code>
                .
              </li>
            </ol>
          </section>
        </article>
      ) : (
        <aside class="callout">
          <div>
            <p class="eyebrow">An honest download boundary</p>
            <h2 id="catalog-heading">No site-verified immutable catalog yet</h2>
            <p>
              This site does not have a verified catalog of exact versions,
              checksums, platforms, compatibility, provenance, and licenses. It
              keeps the owning repository’s release-page fallback instead of
              guessing a direct artifact URL.
            </p>
          </div>
          <div class="card-actions">
            <a
              class="button button--ghost"
              href="https://github.com/atrinik/classic/releases"
            >
              View all Classic releases
            </a>
            <a class="button button--ghost" href="/licenses/">
              Understand the licenses
            </a>
          </div>
        </aside>
      )
    }
  </section>

  <section class="section" aria-labelledby="before-heading">
    <div class="section-heading">
      <p class="eyebrow">Before you begin</p>
      <h2 id="before-heading">Check the release that you choose</h2>
    </div>
    <div class="detail-grid">
      <article class="detail-card">
        <h3>Check platform support</h3>
        <p>
          Published Classic releases include portable Windows x86_64 client and
          server packages. There is no supported native Linux or macOS client,
          and no published editor binary. Confirm the exact release notes before
          installing anything.
        </p>
      </article>
      <article class="detail-card">
        <h3>Keep licenses distinct</h3>
        <p>
          Classic software is GPL-2.0-or-later. Maps, graphics, audio, and other
          authored content can carry separate, per-file terms.
        </p>
      </article>
      <article class="detail-card">
        <h3>Watch the roadmap</h3>
        <p>
          Next-generation availability will be announced through the project’s
          public development and release process when it is ready.
        </p>
      </article>
    </div>
  </section>
</Base>
