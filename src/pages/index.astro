---
import Base from "../layouts/Base.astro";
import media from "../data/media.json";
import site from "../data/site.json";
import { indexablePage, websiteIdentity } from "../lib/metadata";

const getMedia = (id: string) => {
  const record = media.entries.find((entry) => entry.id === id);
  if (!record) throw new Error(`missing media record: ${id}`);
  return record;
};

const crystal = getMedia("great-blue-crystal");
const metadata = indexablePage({
  title: `${site.homepage.title} · ${site.title}`,
  description: site.homepage.description,
  canonicalPath: "/",
  structuredData: [websiteIdentity()],
});
const chronicle = [
  {
    media: getMedia("atrinik-then"),
    number: "I",
    title: "The world we remember",
    text: "The Classic line preserves Atrinik’s isometric world, its long history, and the adventures that first gave the islands their life.",
  },
  {
    media: getMedia("atrinik-now"),
    number: "II",
    title: "The world stirs again",
    text: "Today, Classic remains the playable home while new foundations are built independently, tested openly, and joined with care.",
  },
  {
    media: getMedia("atrinik-beyond"),
    number: "III",
    title: "A vision of what may come",
    text: "The next generation is a direction, not a release promise: fresh engine foundations shaped around the same authored world.",
  },
];
---

<Base metadata={metadata} preloadImage={crystal.publicPath}>
  <section class="home-hero" aria-labelledby="hero-title">
    <div class="hero-copy">
      <p class="eyebrow">{site.homepage.eyebrow}</p>
      <h1 id="hero-title">{site.homepage.heading}</h1>
      <p class="hero-lede">{site.homepage.introduction}</p>
      <div class="hero-actions">
        <a class="button button--primary" href="/downloads/">
          {site.homepage.primaryAction}
          <span aria-hidden="true">→</span>
        </a>
        <a
          class="button button--ghost"
          href="https://github.com/atrinik/atrinik/issues/168"
        >
          Follow the rebuild <span aria-hidden="true">↗</span>
        </a>
      </div>
      <dl class="hero-facts" aria-label="Atrinik project status">
        <div>
          <dt>Classic</dt>
          <dd>Playable &amp; maintained</dd>
        </div>
        <div>
          <dt>Windows</dt>
          <dd>Supported client download</dd>
        </div>
        <div>
          <dt>Next generation</dt>
          <dd>Foundations in development</dd>
        </div>
      </dl>
    </div>
    <figure class="hero-art">
      <div class="hero-art-frame">
        <img
          src={crystal.publicPath}
          width={crystal.width}
          height={crystal.height}
          alt={crystal.alt}
          decoding="async"
          fetchpriority="high"
        />
      </div>
      <figcaption>
        <span>Morliana</span>
        The Great Blue Crystal · temporary concept artwork made by Zoey Rose with
        OpenAI image generation
      </figcaption>
    </figure>
  </section>

  <section class="section" aria-labelledby="identity-heading">
    <div class="section-heading section-heading--split">
      <div>
        <p class="eyebrow">How Atrinik is made</p>
        <h2 id="identity-heading">{site.identity.heading}</h2>
      </div>
      <p>
        Human craft gives the world its character. Agentic engineering builds
        and maintains the software that brings that work to life.
      </p>
    </div>
    <div class="split-grid">
      <article class="detail-card">
        <h3>Human creators direct the game world</h3>
        <p>{site.identity.gameContent}</p>
        <p>
          Atrinik contributors and appropriately licensed work from Crossfire,
          Daimonin, and other human creators retain their exact credit and
          terms; “human-led” describes creative direction and responsibility,
          not solely Atrinik-original work.
        </p>
        <p>
          <strong>Temporary generated artwork:</strong>{" "}
          {site.identity.websiteMediaException}{" "}
          <a href="https://github.com/atrinik/website/issues/22">
            Follow its replacement.</a
          >
        </p>
        <a class="link-arrow" href="/licenses/">
          Read the authorship and provenance boundaries
          <span aria-hidden="true">→</span>
        </a>
      </article>
      <article class="detail-card">
        <h3>Agents help build the software</h3>
        <p>{site.identity.software}</p>
        <p>
          “Generative AI” here means tools that synthesize content or code. It
          is unrelated to gameplay systems such as creature or NPC behavior.
        </p>
        <a class="link-arrow" href="/about/">
          Learn about the development model <span aria-hidden="true">→</span>
        </a>
      </article>
    </div>
  </section>

  <section class="world-intro" aria-labelledby="world-heading">
    <div class="crystal-sigil" aria-hidden="true"><i></i><i></i><i></i></div>
    <p class="eyebrow">From the lore</p>
    <h2 id="world-heading">It fell from the sky.</h2>
    <p>
      In Morliana’s founding story, a blue crystal fell onto a frozen island. An
      expedition found it glowing with warmth amid crystals and gems, and the
      riches they gathered funded a village. Atrinik is full of stories like
      that: discoveries that become homes, and old mysteries that pull new
      adventurers onward.
    </p>
    <a class="link-arrow" href="/about/">
      Discover the world and the project <span aria-hidden="true">→</span>
    </a>
  </section>

  <section class="section" id="paths" aria-labelledby="paths-heading">
    <div class="section-heading section-heading--split">
      <div>
        <p class="eyebrow">One world, two paths</p>
        <h2 id="paths-heading">Choose where you enter.</h2>
      </div>
      <p>
        Classic keeps the world playable today. The next-generation effort is
        building a clean-room foundation for tomorrow. They are distinct
        implementations with clear licenses and compatibility boundaries.
      </p>
    </div>
    <div class="path-grid">
      <article class="path-card path-card--classic">
        <div class="path-card-topline">
          <span class="path-number">Path I</span>
          <span class="status-tag status-tag--live">Playable</span>
        </div>
        <h3>Atrinik Classic</h3>
        <p>
          The maintained GPL-licensed game: one{" "}<code>atrinik/classic</code
          >{" "}repository coordinates the C17 client, server, editor,
          libatrinik, protocol, version, release notes, and release artifacts.
        </p>
        <ul class="path-details">
          <li>Current playable implementation</li>
          <li>Preserved history and world</li>
          <li>One supported 5.x release line</li>
        </ul>
        <div class="card-actions">
          <a class="button button--light" href="/downloads/">
            Find Classic <span aria-hidden="true">→</span>
          </a>
          <a class="text-link" href="https://github.com/atrinik/classic">
            Browse source <span aria-hidden="true">↗</span>
          </a>
        </div>
      </article>
      <article class="path-card path-card--future">
        <div class="path-card-topline">
          <span class="path-number">Path II</span>
          <span class="status-tag">In development</span>
        </div>
        <h3>Next generation</h3>
        <p>
          Fresh MIT engine foundations: a Go server, Rust client and editor,
          shared renderer, new protocol, and content toolkit, developed as
          independently released repositories.
        </p>
        <ul class="path-details">
          <li>Clean-room implementation</li>
          <li>Independent, testable components</li>
          <li>Not yet available as a complete game</li>
        </ul>
        <div class="card-actions">
          <a
            class="button button--light"
            href="https://github.com/atrinik/atrinik/issues/168"
          >
            Read the roadmap <span aria-hidden="true">↗</span>
          </a>
          <a class="text-link" href="https://github.com/atrinik/client">
            Explore the new client <span aria-hidden="true">↗</span>
          </a>
        </div>
      </article>
    </div>
  </section>

  <section
    class="section section--wide chronicle"
    aria-labelledby="chronicle-heading"
  >
    <div class="section-heading section-heading--center">
      <p class="eyebrow">The project chronicle</p>
      <h2 id="chronicle-heading">Then. Now. Beyond.</h2>
      <p>
        Three temporary OpenAI-generated concept-art chapters for a project
        carrying its history forward without pretending the future has already
        arrived. They are website presentation media, not game content.
      </p>
    </div>
    <div class="chronicle-grid">
      {
        chronicle.map(({ media: image, number, title, text }) => (
          <article class="chronicle-card">
            <figure>
              <img
                src={image.publicPath}
                width={image.width}
                height={image.height}
                alt={image.alt}
                loading="lazy"
                decoding="async"
              />
            </figure>
            <div class="chronicle-copy">
              <span>{number}</span>
              <div>
                <h3>{title}</h3>
                <p>{text}</p>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <section class="section project-section" aria-labelledby="project-heading">
    <div class="project-callout">
      <div>
        <p class="eyebrow">Built in the open</p>
        <h2 id="project-heading">The world is open. So is the work.</h2>
      </div>
      <div>
        <p>
          Atrinik's software is developed in public, primarily through
          Codex-driven agentic workflows. Direct human code contributions are
          welcome under the same review, provenance, licensing, and validation
          gates. Classic has one coordinated home; clean-room replacement
          foundations live in focused repositories.
        </p>
        <a
          class="button button--primary"
          href="https://github.com/atrinik/atrinik"
        >
          Enter the project <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
    <nav class="project-links" aria-label="Atrinik source repositories">
      <a href="https://github.com/atrinik/classic">
        <span>Maintained game</span><strong>Classic</strong><i
          aria-hidden="true">↗</i
        >
      </a>
      <a href="https://github.com/atrinik/content">
        <span>Authored world</span><strong>Content</strong><i aria-hidden="true"
          >↗</i
        >
      </a>
      <a href="https://github.com/atrinik/server">
        <span>Next generation</span><strong>Server</strong><i aria-hidden="true"
          >↗</i
        >
      </a>
      <a href="https://github.com/atrinik/renderer">
        <span>Shared foundation</span><strong>Renderer</strong><i
          aria-hidden="true">↗</i
        >
      </a>
    </nav>
  </section>
</Base>
