{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atrinik.org/contracts/media.schema.json",
  "title": "Atrinik website media record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "publicPath",
    "sourceRepository",
    "sourcePath",
    "sourceRevision",
    "sourceSha256",
    "publishedSha256",
    "width",
    "height",
    "author",
    "license",
    "transformations",
    "alt",
    "notice"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "publicPath": {
      "type": "string",
      "pattern": "^/media/[a-z0-9][a-z0-9-]*\\.[0-9a-f]{8}\\.webp$"
    },
    "sourceRepository": { "const": "atrinik/website" },
    "sourcePath": { "type": "string", "minLength": 1, "maxLength": 500 },
    "sourceRevision": {
      "description": "Git SHA-1 blob object ID for the exact source bytes",
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sourceSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "publishedSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "width": { "type": "integer", "minimum": 1, "maximum": 16384 },
    "height": { "type": "integer", "minimum": 1, "maximum": 16384 },
    "author": { "type": "string", "minLength": 1, "maxLength": 200 },
    "license": {
      "type": "string",
      "enum": [
        "MIT",
        "CC0-1.0",
        "CC-BY-4.0",
        "CC-BY-SA-4.0",
        "GPL-2.0-only",
        "GPL-2.0-or-later"
      ]
    },
    "transformations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": { "type": "string", "minLength": 1, "maxLength": 300 }
    },
    "alt": { "type": "string", "minLength": 1, "maxLength": 500 },
    "notice": { "type": "string", "minLength": 1, "maxLength": 500 }
  }
}
