{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atrinik.org/contracts/download.schema.json",
  "title": "Atrinik immutable download record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "releaseRepository",
    "artifactRole",
    "primary",
    "version",
    "tag",
    "revision",
    "publishedAt",
    "verifiedAt",
    "draft",
    "prerelease",
    "immutable",
    "attested",
    "releaseAssets",
    "platform",
    "architecture",
    "archiveFormat",
    "artifact",
    "bytes",
    "sha256",
    "url",
    "releaseNotesUrl",
    "manifestUrl",
    "checksumsUrl",
    "sbomUrl",
    "softwareLicense",
    "bundledAssetsLicense",
    "compatibility",
    "installation"
  ],
  "properties": {
    "releaseRepository": {
      "type": "string",
      "pattern": "^atrinik/[a-z][a-z0-9-]*$"
    },
    "artifactRole": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "primary": { "type": "boolean" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "tag": { "type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "publishedAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "verifiedAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "draft": { "const": false },
    "prerelease": { "const": false },
    "immutable": { "const": true },
    "attested": { "const": true },
    "releaseAssets": { "type": "integer", "minimum": 1, "maximum": 200 },
    "platform": { "enum": ["linux", "macos", "windows"] },
    "architecture": { "enum": ["x86_64"] },
    "archiveFormat": { "enum": ["tar.gz", "zip"] },
    "artifact": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]+$" },
    "bytes": { "type": "integer", "minimum": 1, "maximum": 2147483648 },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "url": {
      "type": "string",
      "pattern": "^https://github\\.com/atrinik/[a-z0-9-]+/releases/download/v[0-9]+\\.[0-9]+\\.[0-9]+/[A-Za-z0-9._-]+$"
    },
    "releaseNotesUrl": {
      "type": "string",
      "pattern": "^https://github\\.com/atrinik/[a-z0-9-]+/releases/tag/v[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "manifestUrl": {
      "type": "string",
      "pattern": "^https://github\\.com/atrinik/[a-z0-9-]+/releases/download/v[0-9]+\\.[0-9]+\\.[0-9]+/release-manifest\\.json$"
    },
    "checksumsUrl": {
      "type": "string",
      "pattern": "^https://github\\.com/atrinik/[a-z0-9-]+/releases/download/v[0-9]+\\.[0-9]+\\.[0-9]+/SHA256SUMS$"
    },
    "sbomUrl": {
      "type": "string",
      "pattern": "^https://github\\.com/atrinik/[a-z0-9-]+/releases/download/v[0-9]+\\.[0-9]+\\.[0-9]+/[A-Za-z0-9._-]+\\.spdx\\.json$"
    },
    "softwareLicense": { "enum": ["GPL-2.0-or-later", "MIT"] },
    "bundledAssetsLicense": {
      "type": "string",
      "minLength": 20,
      "maxLength": 300
    },
    "compatibility": { "type": "string", "minLength": 20, "maxLength": 300 },
    "installation": { "type": "string", "minLength": 20, "maxLength": 500 }
  },
  "allOf": [
    {
      "if": {
        "properties": { "primary": { "const": true } },
        "required": ["primary"]
      },
      "then": {
        "properties": {
          "releaseRepository": { "const": "atrinik/classic" },
          "artifactRole": { "const": "client" },
          "releaseAssets": { "const": 12 },
          "platform": { "const": "windows" },
          "architecture": { "const": "x86_64" },
          "archiveFormat": { "const": "zip" },
          "softwareLicense": { "const": "GPL-2.0-or-later" }
        }
      }
    }
  ]
}
